# Helvetly — environment settings.
#
# Copy to `.env` (git-ignored). One file serves everything:
#   - `pnpm dev` loads it into the API (apps/api), which checks every value at startup and refuses to
#     start on a bad one;
#   - compose.yml reads it for the local services (Postgres, S3, Mailpit, Stripe CLI);
#   - the Next.js apps read only their process env, so their values here are defaults you can override.
# An empty value means "use the built-in default". Never commit real secrets.
#
# Groups: 1 Server · 2 Database · 3 Sign-in and sessions · 4 Email · 5 File storage · 6 Billing ·
#         7 AI · 8 E-invoicing · 9 Frontends · 10 Local services · 11 Tests


# ══════════════════════════════════════════════════════════════════════════════
# 1. Server — where the API listens and how the outside world reaches it
# ══════════════════════════════════════════════════════════════════════════════

# Address the Go server listens on.
HTTP_ADDR=:3333

# Origin the browser sees for the platform. Used for the Google redirect URI, the passkey relying
# party (RP ID and origin) and links in emails. Must be https unless the host is local (also PORTAL_URL).
PUBLIC_URL=http://localhost:8000

# Reverse proxies (comma-separated CIDRs or addresses) whose X-Forwarded-For names the client, for rate
# limits, session and signature audit addresses. Empty = the TCP peer; set it when behind a proxy.
# `cloudflare` stands for Cloudflare's published edge ranges: behind the Cloudflare proxy (e.g. 172.18.0.2,cloudflare)
# the API also believes CF-IPCountry, which picks the currency (CHF, EUR or USD) a new customer pays in.
TRUSTED_PROXY_CIDRS=

# Origin of the client portal (apps/portal): its own host, e.g. https://portal.helvetly.com. The same
# binary serves it to requests for this host; links in portal invitations point here. Required when
# PUBLIC_URL is not local, and never the same host as PUBLIC_URL.
PORTAL_URL=http://localhost:8002

# Origin of the developer docs site, e.g. https://docs.helvetly.com. Its API playground may call the
# documented public operations from the reader's browser with a pasted API token (CORS for this exact origin, no
# cookies). Default: http://localhost:8003 next to a local PUBLIC_URL, otherwise off; a public PUBLIC_URL needs https.
DOCS_URL=

# Origin that serves file downloads as short-lived signed links (/api/media/… on this binary), e.g. https://media.helvetly.com: another host than PUBLIC_URL and PORTAL_URL, https unless local. Empty = presigned S3 links or S3_PROXY_DOWNLOADS.
MEDIA_URL=

# Origin bearer clients and agents are pointed at (the platform's API & MCP settings show it), e.g. https://api.helvetly.com:
# the same binary on another host than PUBLIC_URL and PORTAL_URL, https unless local. Empty = PUBLIC_URL.
PUBLIC_API_URL=

# Custom portal domains (Business plan): a workspace serves its client portal on its own host, e.g. portal.firma.ch,
# through Cloudflare for SaaS custom hostnames on your zone. The customer adds a CNAME to CUSTOM_DOMAIN_TARGET and the
# TXT record Cloudflare names; Helvetly creates, checks and deletes the custom hostname, checks the TXT record itself,
# and Cloudflare issues the certificate. Your proxy must pass any other Host from Cloudflare to this binary (README,
# "Custom portal domains"). All three or none; empty = off.
# CLOUDFLARE_API_TOKEN: Zone · SSL and Certificates · Edit on that zone only. CLOUDFLARE_ZONE_ID: the zone's id.
# CUSTOM_DOMAIN_TARGET: the proxied hostname customers point their CNAME at and the zone's custom-hostname fallback
# origin; normally PORTAL_URL's host (portal.helvetly.com).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_TARGET=


# ══════════════════════════════════════════════════════════════════════════════
# 2. Database — PostgreSQL; migrations run automatically at startup
# ══════════════════════════════════════════════════════════════════════════════

# Matches the `db` service in section 10. The pool keeps at most 20 connections unless the URL sets
# pool_max_conns (e.g. &pool_max_conns=40); keep it below max_connections across all instances.
DATABASE_URL=postgres://helvetly:helvetly@localhost:5433/helvetly?sslmode=disable


# ══════════════════════════════════════════════════════════════════════════════
# 3. Sign-in and sessions — passwordless: email code, Google, passkeys
# ══════════════════════════════════════════════════════════════════════════════

# 32 random bytes, base64 (`openssl rand -base64 32`). Seals the Google sign-in state, keys IP hashing
# and seals stored channel credentials. May stay empty only with AUTH_DEV_SIGNIN=true.
SECRET_KEY=

# How long a session lasts (Go duration).
SESSION_TTL=720h

# Secure cookies. Empty = true when PUBLIC_URL is https; false is refused on a public https PUBLIC_URL.
COOKIE_SECURE=

# Google sign-in: set both or neither (the button is hidden when empty).
# Authorized redirect URI to register: <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calendar sync (Scheduling): members connect their own Google or Microsoft 365 / Outlook calendar; sessions are
# pushed there and their busy times come back. Each provider: both or neither; empty = that provider is not offered.
# Google: its own Google Cloud OAuth client (not the sign-in one), Calendar API on, scopes calendar.events and
# calendar.calendarlist.readonly. Redirect URI: <PUBLIC_URL>/api/v1/scheduling/calendars/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft: an Entra ID app registration (multitenant + personal accounts), delegated Graph permissions
# openid email offline_access User.Read Calendars.ReadWrite.
# Redirect URI: <PUBLIC_URL>/api/v1/scheduling/calendars/microsoft/callback. MICROSOFT_TENANT: common by default.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
# Change notifications need a public https PUBLIC_URL; elsewhere calendars are polled every 15 minutes.
# Tests only: GOOGLE_CALENDAR_API_URL and MICROSOFT_GRAPH_URL replace every endpoint of a provider with one root;
# HELVETLY_E2E_FAKE_CALENDARS=true serves fake providers from the API itself (needs AUTH_DEV_SIGNIN).

# Development only. Email codes work without SMTP and are readable at
# GET /api/v1/auth/email/dev-code?email=…  Refused on a public origin; never set it in production.
AUTH_DEV_SIGNIN=true


# ══════════════════════════════════════════════════════════════════════════════
# 4. Email — sign-in codes, invoices, reminders, notifications (SMTP)
#    The defaults point at Mailpit (section 10).
# ══════════════════════════════════════════════════════════════════════════════

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | tls | none — `none` only for a trusted local relay such as Mailpit.
SMTP_TLS=none
# Quoted: the dev script sources this file in a shell.
MAIL_FROM="Helvetly <no-reply@helvetly.local>"
# Where Help & feedback reports are emailed; empty = they are only stored (product_feedback).
FEEDBACK_EMAIL=

# Operator alerts to one private Telegram chat. Set both together to enable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# GA4 measurement id (G-...) of the platform's page views, path only (no query or fragment); empty = no analytics.
GOOGLE_ANALYTICS_ID=


# ══════════════════════════════════════════════════════════════════════════════
# 5. File storage — any S3-compatible bucket for documents, receipts and PDFs
#    Requirements: README, "Object storage".
#    Locally the MaxIOFS service (section 10); its console is at http://localhost:9301 (admin / admin).
# ══════════════════════════════════════════════════════════════════════════════

# S3 API the API uploads to; browsers download from it through presigned links, so in production it
# must be reachable from the browser (or set S3_PROXY_DOWNLOADS).
S3_ENDPOINT=http://localhost:9300
S3_REGION=us-east-1
S3_BUCKET=helvetly
# Required. compose.yml creates the local bucket with these.
S3_ACCESS_KEY=helvetly
S3_SECRET_KEY=helvetly-secret
# true = downloads stream through the API instead of a 302 to a presigned S3 URL, for a bucket the
# browser cannot reach (`pnpm dev:tunnel` sets it: a public origin cannot load localhost S3).
S3_PROXY_DOWNLOADS=false
# path (default) = <endpoint>/<bucket>/<key>; virtual = <bucket>.<endpoint host>/<key>, for a service that
# accepts only that. S3_ENDPOINT is a scheme and host only, never with the bucket or credentials in it.
S3_ADDRESSING=path

# Storage protection of business records (issued invoice PDFs and XML, booked receipts, signature
# originals and signed PDFs) with standard S3 Object Lock.
#   0 = off: files are stored and served normally (versioning used if the bucket has it), no Object Lock
#       call is made, nothing is queued, and no record is ever shown as protected.
#   > 0 = required: the bucket must have Object Lock enabled or the API refuses to start (it never falls
#       back to off). Each object version is locked to the end of the tenth business year after its
#       record (OR 958f/GeBüV), and at least this many days; confirmed only after reading the lock back.
# Mode: COMPLIANCE (nobody can shorten it) or GOVERNANCE (a privileged user can). Never changed silently.
S3_OBJECT_LOCK_DAYS=0
S3_OBJECT_LOCK_MODE=COMPLIANCE

# Largest file Documents accepts, in megabytes (1–25; 25 MB is the largest file any upload takes).
DOCUMENTS_MAX_UPLOAD_MB=25


# ══════════════════════════════════════════════════════════════════════════════
# 6. Billing — Stripe subscriptions and plan limits
#    Empty STRIPE_SECRET_KEY turns billing off: no Checkout, and no plan limit applies.
#    Prices and limits are not settings: prices are read from Stripe by lookup key
#    (helvetly_<basic|pro|business>_<month|year>, per seat; README "Billing"), and the features and limits
#    (AI tokens included) come from the published offer in the database (`helvetly offer …`).
# ══════════════════════════════════════════════════════════════════════════════

# sk_test_… locally. With a key, the webhook secret is required: `docker compose logs stripe` prints it
# (whsec_…) once the Stripe CLI service forwards test-mode webhooks to /api/webhooks/stripe. Only while rotating
# the secret, list the new and the old one separated by commas (whsec_new,whsec_old): an event signed with either
# is taken, and each event id is applied once. The endpoint's API version does not matter (billing reads every
# object again from Stripe with its pinned version), so a version change needs no new endpoint or secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Tax in Checkout (default true; needs Stripe Tax set up in the dashboard).
STRIPE_AUTOMATIC_TAX=
# Stripe Managed Payments: Stripe is the merchant of record (tax, invoices, disputes); default false. Needs it enabled
# in the dashboard and the SaaS tax code txcd_10103001 on the products; replaces STRIPE_AUTOMATIC_TAX in Checkout.
STRIPE_MANAGED_PAYMENTS=
# Default https://api.stripe.com; point at stripe-mock or a fake to test without Stripe.
STRIPE_API_BASE=


# ══════════════════════════════════════════════════════════════════════════════
# 7. AI — the model behind Heidi and the AI import
#    Empty OPENAI_API_KEY = no model: Heidi answers local factual commands only and import is off.
#    Each member must approve AI use for themselves in each workspace before any content is sent.
#    The monthly token allowance is the plan limit ai_tokens_per_month.
# ══════════════════════════════════════════════════════════════════════════════

OPENAI_API_KEY=
# API root of OpenAI or an OpenAI-compatible gateway (https; plain http only on a local host).
OPENAI_BASE_URL=https://api.openai.com/v1
# A model with a rate card in apps/api/internal/aimodel/rates.go; the plans are priced for gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
# Optional second model with a rate card, other than OPENAI_MODEL, asked once when OPENAI_MODEL is still overloaded
# (503) or rate limited after its retries; it is priced and counted at its own card. Empty = none.
OPENAI_FALLBACK_MODEL=


# ══════════════════════════════════════════════════════════════════════════════
# 8. E-invoicing — national e-invoice APIs (optional)
# ══════════════════════════════════════════════════════════════════════════════

# Polish KSeF 2.0 API root for sending FA(3) invoices; empty = off (the FA(3) file download works
# without it). TEST https://api-test.ksef.mf.gov.pl/v2 (self-signed certificates, never real data),
# DEMO https://api-demo.ksef.mf.gov.pl/v2, PROD https://api.ksef.mf.gov.pl/v2.
KSEF_API_URL=

# Swiss UID register (Federal Statistical Office, public SOAP service, no login) for the client form's company
# lookup and the "verified" mark. Unset = the federal production endpoint below; off = no lookups. The service
# allows 20 requests a minute per caller; each API instance stays at 15 and caches answers for 10 minutes.
UID_REGISTER_URL=https://www.uid-wse.admin.ch/V5.0/PublicServices.svc

# Address suggestions for a session's location: Photon (OpenStreetMap data, by komoot; free, no key; only the typed
# text, the workspace's country and the user's language are sent). Unset = the public instance below, or point it
# at a self-hosted Photon; off = no suggestions. Each API instance caches answers for 10 minutes and stays at
# 120 calls a minute, 30 per workspace.
ADDRESS_SUGGEST_URL=https://photon.komoot.io/api/


# ══════════════════════════════════════════════════════════════════════════════
# 9. Frontends — apps/platform (signed-in app) and apps/web (landing page)
# ══════════════════════════════════════════════════════════════════════════════

# Where `next dev` of the platform proxies /api/* (must match HTTP_ADDR).
API_URL=http://localhost:3333

# Where the landing page's "Sign in" links to.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8000

# The developer docs (API reference, MCP guide) the platform links to. pnpm dev:tunnel uses dev-docs.example.com.
NEXT_PUBLIC_DOCS_URL=https://docs.helvetly.com

# The public website the platform and portal link to (terms, privacy).
NEXT_PUBLIC_WEB_URL=https://www.helvetly.com

# Google Analytics 4 measurement id of the website (apps/web), baked in at build time; empty = no analytics. Only
# helvetly.com hosts send anything (deploy.yml in the infra repo sets it from the GA_ID variable).
NEXT_PUBLIC_GA_ID=


# ══════════════════════════════════════════════════════════════════════════════
# 10. Local services — compose.yml (`pnpm infra:up`), all bound to 127.0.0.1
#     Development only; production uses managed services configured in sections 2, 4 and 5.
# ══════════════════════════════════════════════════════════════════════════════

# Postgres (DATABASE_URL in section 2 points here).
POSTGRES_USER=helvetly
POSTGRES_PASSWORD=helvetly
POSTGRES_DB=helvetly
POSTGRES_PORT=5433

# MaxIOFS (S3): API and console ports. The bucket and keys come from section 5.
S3_PORT=9300
S3_CONSOLE_PORT=9301

# Mailpit inbox UI at http://localhost:8026 (its SMTP port is SMTP_PORT in section 4).
MAIL_UI_PORT=8026

# Host port the Stripe CLI forwards webhooks to (must match HTTP_ADDR).
API_PORT=3333


# ══════════════════════════════════════════════════════════════════════════════
# 11. Tests — not read from .env: export them in the shell that runs the tests, only to override
#     the defaults. Every test makes and removes its own schema and bucket, on loopback only.
# ══════════════════════════════════════════════════════════════════════════════

# Go tests (`pnpm --filter @helvetly/api test`): the server where each test gets its own database,
# cloned from a template migrated once.
# HELVETLY_TEST_DATABASE_URL=postgres://helvetly:helvetly@localhost:5433/helvetly?sslmode=disable
# Opt-in Go tests: 1 = also against the real local bucket / the pinned XSD schemas / the public KSeF
# TEST environment (never in CI).
# HELVETLY_TEST_S3=1
# HELVETLY_TEST_XSD=1
# HELVETLY_TEST_KSEF=1

# Playwright E2E (`pnpm test:e2e`) needs no settings: it starts its own disposable Postgres and S3 from
# compose.e2e.yml (ports 5434 and 9310; `pnpm e2e:down` removes them).
